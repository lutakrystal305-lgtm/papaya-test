{
  "name": "policy-benefits-calculator",
  "version": "0.1.0",
  "description": "AI Challenge 06 \u2014 Policy Benefits Calculator (NestJS HTTP API + CLI)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20",
    "npm": "please-use-yarn"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "calc": "ts-node --transpile-only -r tsconfig-paths/register src/cli.ts calc",
    "calc:prod": "node dist/cli calc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:record": "jest --ci --coverage --json --outputFile=test-results/jest-results.json && jest --ci --config ./test/jest-e2e.json --json --outputFile=test-results/jest-e2e-results.json",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!main.ts",
      "!cli.ts",
      "!**/*.module.ts",
      "!testing/**"
    ],
    "coverageDirectory": "../test-results/coverage",
    "coverageReporters": [
      "text",
      "json-summary",
      "lcov"
    ],
    "testEnvironment": "node",
    "coverageThreshold": {
      "./src/calculations/utils/money.ts": {
        "branches": 100
      },
      "./src/calculations/utils/iso-date.ts": {
        "branches": 100
      },
      "./src/calculations/utils/copay-rule.ts": {
        "branches": 100
      },
      "./src/calculations/": {
        "lines": 80
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nest-commander": "^3",
    "nestjs-pino": "^5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^11",
    "@types/inquirer": "^8",
    "@types/jest": "^29",
    "@types/node": "^22",
    "@types/supertest": "^6",
    "ajv": "^8",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "globals": "^17.14.0",
    "jest": "^29",
    "nest-commander-testing": "^3",
    "pino-pretty": "^13.2.0",
    "prettier": "^3",
    "supertest": "^7",
    "ts-jest": "^29",
    "ts-node": "^10",
    "tsconfig-paths": "^4",
    "typescript": "~5.9",
    "typescript-eslint": "^8"
  }
}
