{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy-benefits-calculator/policy.schema.json",
  "title": "Policy",
  "description": "Calculator policy format, based on AI Challenge 05 (not compatible with it; see clarification Q1). Cross-field rules that JSON Schema cannot express are listed in x-cross-field-rules and enforced by the parser.",
  "type": "object",
  "required": ["policy_number", "plan", "benefits"],
  "additionalProperties": true,
  "properties": {
    "policy_number": { "type": "string", "minLength": 1 },
    "plan": {
      "type": "object",
      "required": ["effective_date", "expiry_date", "currency"],
      "properties": {
        "name": { "type": "string" },
        "effective_date": { "$ref": "#/$defs/isoDate" },
        "expiry_date": { "$ref": "#/$defs/isoDate" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "benefits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/benefitType" }
    },
    "exclusions": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/exclusion" }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Calendar date YYYY-MM-DD; must be a real date."
    },
    "positiveAmount": { "type": "number", "exclusiveMinimum": 0 },
    "benefitType": {
      "type": "object",
      "required": ["type", "sub_benefits"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "annual_limit": { "$ref": "#/$defs/positiveAmount" },
        "lifetime_limit": { "$ref": "#/$defs/positiveAmount" },
        "waiting_period_days": { "type": "integer", "minimum": 0, "default": 0 },
        "deductible": { "type": "number", "minimum": 0, "default": 0 },
        "copay": { "$ref": "#/$defs/copayRule" },
        "sub_benefits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/subBenefit" }
        }
      },
      "oneOf": [
        { "required": ["annual_limit"], "not": { "required": ["lifetime_limit"] } },
        { "required": ["lifetime_limit"], "not": { "required": ["annual_limit"] } }
      ]
    },
    "subBenefit": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "limit_per_visit": { "$ref": "#/$defs/positiveAmount" },
        "limit_per_event": { "$ref": "#/$defs/positiveAmount" },
        "limit_per_day": { "$ref": "#/$defs/positiveAmount" },
        "max_days": { "type": "integer", "minimum": 1 },
        "limit_per_year": { "$ref": "#/$defs/positiveAmount" },
        "visits_per_year": { "type": "integer", "minimum": 1 },
        "copay": { "$ref": "#/$defs/copayRule" }
      },
      "dependentRequired": { "max_days": ["limit_per_day"] }
    },
    "copayRule": {
      "oneOf": [
        {
          "type": "object",
          "required": ["percentage"],
          "additionalProperties": false,
          "properties": {
            "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
            "max_per_visit": { "$ref": "#/$defs/positiveAmount" }
          }
        },
        {
          "type": "object",
          "required": ["fixed_per_visit"],
          "additionalProperties": false,
          "properties": {
            "fixed_per_visit": { "$ref": "#/$defs/positiveAmount" }
          }
        }
      ]
    },
    "exclusion": {
      "type": "object",
      "required": ["label", "terms"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "x-cross-field-rules": [
    "plan.expiry_date must be after plan.effective_date",
    "benefits[].type values must be unique",
    "benefits[].sub_benefits[].name values must be unique within a benefit type",
    "at most one of limit_per_visit, limit_per_event, limit_per_day per sub-benefit",
    "all validation errors are collected and reported together; no expense is processed when any exist (FR-006)"
  ]
}
