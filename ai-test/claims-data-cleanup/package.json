{
  "name": "claims-data-cleanup",
  "version": "0.1.0",
  "description": "AI Challenge 02 — Claims Data Cleanup & Report (TypeScript CLI)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20",
    "npm": "please-use-yarn"
  },
  "scripts": {
    "generate": "tsx src/cli.ts generate",
    "clean": "tsx src/cli.ts clean",
    "all": "tsx src/cli.ts all",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:record": "jest --ci --coverage --json --outputFile=test-results/jest-results.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\""
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/jest": "^29",
    "@types/node": "^22",
    "ajv": "^8",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5",
    "globals": "^17",
    "jest": "^29",
    "prettier": "^3.9",
    "ts-jest": "^29.4",
    "tsx": "^4.23",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72"
  }
}
